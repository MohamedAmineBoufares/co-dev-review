{
  "name": "co-dev-review",
  "version": "1.4.0",
  "description": "MCP server for senior-level code reviews, Azure DevOps task planning and Sonar triage, with human-approved publication. Works with any MCP client.",
  "keywords": [
    "code-review",
    "mcp",
    "gitlab",
    "github",
    "azure-devops",
    "sonarqube",
    "react",
    "typescript",
    "dotnet"
  ],
  "author": "Mohamed Amine Boufares",
  "license": "MIT",
  "homepage": "https://github.com/MohamedAmineBoufares/co-dev-review#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohamedAmineBoufares/co-dev-review.git"
  },
  "bugs": {
    "url": "https://github.com/MohamedAmineBoufares/co-dev-review/issues"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.20.2"
  },
  "bin": {
    "co-dev-review": "src/cli.js"
  },
  "files": [
    "src/",
    "skills/",
    "templates/",
    "docs/",
    "examples/",
    "scripts/list-tools.js",
    ".claude-plugin/",
    "plugin-mcp.json",
    "README.md"
  ],
  "scripts": {
    "start": "node src/cli.js serve",
    "setup": "node src/cli.js init",
    "doctor": "node src/cli.js doctor",
    "approve": "node src/cli.js approve",
    "tools": "node scripts/list-tools.js",
    "schema": "node scripts/list-tools.js --schema",
    "check": "node scripts/check.js",
    "test": "node --test",
    "verify": "npm run check && npm test",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "jsonc-parser": "3.3.1",
    "zod": "3.25.76"
  }
}
